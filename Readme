readme = """# Akash Gunnalli — Personal Portfolio

## Pages
- `index.html` — Home page with the supplied photograph as a darkened background
- `about.html` — Introduction, education, skills, languages
- `resume.html` — Internship, education, and academic projects
- `contact.html` — Phone, email, and social links

## Preview locally
Open `index.html` in a browser. Keep `styles.css`, `script.js`, and the `assets` folder alongside the HTML files.

## Publish with GitHub Pages
1. Create or open the repository `akash-profile`.
2. Upload all files and the `assets` folder to the repository root.
3. In GitHub, open Settings → Pages.
4. Select Deploy from a branch, choose `main` and `/ (root)`, then Save.
5. Your site can be published at `https://akashgunnalli.github.io/akash-profile/`.

## Before publishing
Update Instagram and Facebook links in `contact.html` to your personal profile URLs. Check your GitHub username/link is correct.
"""
(base / "README.md").write_text(readme, encoding="utf-8")

zip_path = Path("/mnt/data/Akash_Gunnalli_Portfolio.zip")
with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for f in base.rglob("*"):
        if f.is_file():
            z.write(f, f.relative_to(base.parent))
print(f"Created {zip_path} ({zip_path.stat().st_size:,} bytes)")
                 
