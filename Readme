def page(title, active, body):
    flags = {k: ('class="active"' if k == active else '') for k in ['home','about','resume','contact']}
    header = nav.format(**flags)
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="Portfolio of Akash Gunnalli, MCA graduate and aspiring Full Stack Java Developer.">
<title>{title} | Akash Gunnalli</title><link rel="stylesheet" href="styles.css"></head><body>
{header}{body}{footer}<script src="script.js"></script></body></html>"""

